<!-- vim: ft=xml -->
<Project>
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Fix: only fail build on critical vulnerabilities, not high -->
    <NuGetAuditLevel>critical</NuGetAuditLevel>

    <!-- Fix: suppress these specific known advisories solution-wide -->
    <NuGetAuditSuppress>
      https://github.com/advisories/GHSA-rvv3-g6hj-g44x;
      https://github.com/advisories/GHSA-37gx-xxp4-5rgx;
      https://github.com/advisories/GHSA-w3x6-4m5h-cxqf
    </NuGetAuditSuppress>

  </PropertyGroup>
  <ItemGroup>
    <!--PackageReference Include="SonarAnalyzer.CSharp" Version="9.23.0.88079" PrivateAssets="all" Condition="$(MSBuildProjectExtension) == '.csproj'"/-->
  </ItemGroup>
</Project>